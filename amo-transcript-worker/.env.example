# Скопируй в .env рядом с worker.js и заполни. .env в git не попадает.
#
# На сервере neoved файл лежит в /srv/amo/app/workers/amo-transcript/.env

WORKER_NAME=amo-transcript

# ─────────────────────────── amoCRM ───────────────────────────
AMO_SUBDOMAIN=neoved

# ВНИМАНИЕ: нужен ОТДЕЛЬНЫЙ токен — у общего (shared/.env) scope только `crm`,
# и хранилище файлов отвечает ему 403 «Invalid scope».
# Настройки → Интеграции → «+ Создать интеграцию» → Внешняя интеграция →
# в правах отметить «Доступ к файлам» → «Ключи и доступы» → «Долгосрочный токен».
# Проверить права у токена: вторая часть JWT (base64) должна содержать
# "scopes":["crm","files"].
AMO_TOKEN=

# Произвольная строка: часть адреса вебхука и отладочных ручек.
# Сгенерировать: node -e "console.log(crypto.randomUUID().replace(/-/g,''))"
HOOK_SECRET=

# ─────────────────────────── поведение ───────────────────────────
# Какой файл считаем расшифровкой (регулярка, регистр не важен).
TRANSCRIPT_NAME_RE=перевод звонка в текст

# lead — примечание в сделку (её открывает менеджер),
# contact — в карточку контакта (туда Телфин кладёт сам файл),
# both — и туда и туда.
TARGET=lead

# Если у контакта нет ни одной сделки — писать в контакт, чтобы текст не пропал.
FALLBACK_TO_CONTACT=true

# Разговоры короче этого пропускаем: в их расшифровке «Алло. Да. До свидания».
# 0 — писать все.
MIN_DURATION_SEC=20

# Лимит текста примечания в amoCRM: 20 001 символ уже отвергается (TooLong).
# Расшифровка — примерно 1 300 символов на минуту речи, то есть одно примечание
# вмещает около 15 минут разговора; длиннее режется на части.
MAX_NOTE_CHARS=20000

# Окно назад от файла, в котором ищется примечание-звонок (для шапки).
CALL_WINDOW_SEC=900

# Шапка «Расшифровка звонка · исходящий · 3:47 · +7…» перед текстом.
HEADER=true
